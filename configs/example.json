{
    // Run name will be used to save output files
    "run_name": "boost_NR_bin4",
    "notes": "You can add custom notes to remind yourself what you were trying in this run",

    // If specified and > 0, kdata will be reduced to debug faster
    // e.g. set to 20
    "debug_ksize": 0,

    // Choose to override results if using the same run_name
    "override_if_exists": false,

    // Input and Output folders
    // Use $WORKSPACE to replace by your workspace folder
    // Use ~ to replace by your home
    "folder_input": "$WORKSPACE/input", // will look here for twix and base DICOMs (HB1, HB2, BB)
    "folder_output": "$WORKSPACE/output", // see list of what will be stored in README

    // Raw data from scanner
    "twix_fname": "example_twix.dat",

    // Whether or not to save to file
    "save_dcm": true, // whether or not to store resulting dicom file
    "save_dcm_intrabin": false, // whether or not to store intrabin reconstruction
    "save_csm": false, // whether or not to save .mat file with csm
    "save_data": false, // whether or not to save .mat file with moco data
    "save_images": false, // whether or not to save .mat file with (noisy) images

    "load_motion_curves": true, // whether or not to load curves from file
    // if false, requires UI to select iNAV

    "zero_rl_motion": true, // if true will ignore right-left motion

    // Output DICOM params
    "dicom_params": {
        // clamp image values by a percentage before saving to DICOM
        "min_perc": 10,
        "max_perc": 100,
    },

    "coil_params": {
        "use_only": [], // pass empty list to use all coils
        "csm_algorithm": "ESPIRiT", // SOS, ESPIRiT, WASLH
        "n_compressed_coils": -1, // Set to -1 to not compress coils
        "reject_via_ui": false, // display UI to reject coils manually
    },
    "selected_contrasts": {
        // pass empty list to use all
        "echoes": [],
        "sets": [],
        "repetitions": [],
    },
    "selected_contrasts_for_rating": {
        // select contrast to use for coils
        "echo": 1,
        "set": 1,
        "repetition": 1,
    },
    "motion_correction_params": {
        "type": "non_rigid", // none, translational, non_rigid
        "ref_bin": 4, // 1: inspiration, 4: expiration
        "bin_recon_mode": "it_sense", // it_sense, orcca
    },
    "reconstruction_type": "it_SENSE", // it_SENSE, admm
    "denoising_type": "HD_PROST", // none, HD_PROST
    "water_fat_algorithm": "none",
    "prost_params": {
        "sig": 0.055,
        "patch_sz": 5,
        "max_patch": 20,
        "win": 20,
        "offset": 4,
        "debug": 1,
        "recon_mode": 6,
        "sharpness": 0,
        "type": 0,
    },
    "cg_params": {
        "ADMM_maxit": 3,
        "CG_minres": 1e-10,
        "CG_maxit_ini": 5,
        "CG_maxit": 5,
        "CG_lambda": 0.01,
    }
}
