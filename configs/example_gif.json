{
  // Acquisition folder
  "acq_folder": "$WORKSPACE/acquisitions/2024-01-01_HV_SEQ",

  // If true, prints more information to stdout
  "verbose": false,

  // Which DCMs to use, see options below
  "mode": "gif_final_recons",
  // "png_final_recon": use one final recon to create PNGs
  // "gif_bin_images": use bin images from one recon to create GIFs
  // "gif_final_recons": use final reconstructions from multiple recons to create GIFs
  // "gif_xyz": use one final recon to create x, y and z GIFs

  // If mode other than "gif_final_recons" set 1 recon
  //"run_name": "RUN_1",

  // If mode == "gif_final_recons" set multiple recons
  "run_name": [
    "RUN_1",
    "RUN_2",
    "RUN_3",
    "RUN_4", // GIFs will be saved in the last recon
  ],

  // Choose contrast to select DCM files
  "contrast_name": "HB1",
  // If mode == "png_final_recon", will look for file HB1.dcm
  // If mode == "gif_bin_images", will look for files: HB1-bin01.dcm, HB1-bin02.dcm, etc
  // If mode == "gif_final_recons", will look for HB1.dcm files in each recon folder

  // Add a suffix to the output GIF folder
  "name_suffix": "",

  // Params to normalize brightness across images
  "norm_brightness_params": {
    "apply": true,
    "target": "mean", // one of min, max, mean, median or number
        // if number: which image to use as target brightness
  },

  // Choose MIP params
  "mip_params": {
    "apply": true, // whether or not to apply MIP to each image
    "thickness": 10, // number of slices to grab to either side
    "axis": "z", // which axis to apply MIP, one of "x", "y", "z"
  },

  // Choose Lookup Table params
  "lut_params": {
    "apply": false, // whether or not to apply window and level
    "window": 1399,
    "level": 391,
  },

  "percentile_params": {
    "apply": true, // whether or not to clip percentiles
    "min_perc": 1,
    "max_perc": 99,
  },

  // Choose PNG generation params (for "png_" modes only)
  "png_params": {
    "axis": "z", // which axis to slice to generate PNGs, one of "x", "y", "z"
  },

  // Choose GIF generation params (for "gif_" modes only)
  "gif_params": {
    "delay_time": 0.2, // delay seconds between animated slices
    "total_time": 0, // total GIF seconds, if >0 overrides delay_time
    // tip: dont go below delay_time=0.02, as browsers cannot display it

    "axis": "z", // which axis to slice to generate GIFs, one of "x", "y", "z"
      // For a regular DCM:
      // "x" will generate transversal images
      // "y" will generate sagittal images
      // "z" will generate coronal images
  }
}
