{
    // Run name will be used to save output files
    "run_name": "NR_itsense",
    "run_name_prepend_datestamp": false, // prepend "yyyy-mm-dd_" to run_name

    "notes": "You can add custom notes to remind yourself what you were trying in this run",

    // If specified and > 0 (e.g. 20), kdata will be reduced to run the code faster,
    // only useful to test the code
    // If present, will add "_DEBUG" to the run_name
    "debug_ksize": 0,

    // Whether or not to override results if using the same run_name
    "override_if_exists": false,

    // Acquisition folder
    // Use $WORKSPACE to replace by your workspace folder
    // Use ~ to replace by your home
    "acq_folder": "$WORKSPACE/acquisitions/ismrm2024/2024-01-01_HV1_BOOST",

    // Raw data from scanner
    // Will be searched in folder: acq_folder/raw/
    "twix_fname": "example_twix.dat",

    // Motion curve options
    "motion_curve": {
        "name": "inav-heart", // motion curves to load. Set to "scanner" to use ROI planned in the scanner
        "zero_rl": true, // if true will ignore right-left motion
        "zero_fh": false, // if true will ignore foot-head motion
        "scanner_params": { // used only if name == "scanner*"
            "length_factor": 1, // multiply scanner ROI height and width by this factor
        },
    },

    // Options for the sequence
    "seq_params": {
        "scanner_dcms": ["HB1", "HB2"], // Names of the input DCM files for each contrast, set to null if not used
        "contrast_names": ["HB1", "HB2"], // contrast names, will be used to store output DCMs
        // Note about order for multiple echoes (contrasts), sets (HBs) or repetitions (volumes):
        // names will be iterated simulating this triple loop:
        // for repetitions
        //     for sets
        //         for echoes
        "bb": { // if present will calculate black-blood image from HB1-HB2
		    "scanner_dcm": "BB", // Name of the input DCM file for black blood
		    "contrast_name": "BB", // Name for the BB output DCM
	    },
        "dixon": { // if present will calculate F/W images from in-phase and opp-phase images
            "scanner_dcm_water": "W", // name of the input DCM file for water, if any
            "scanner_dcm_fat": "F", // name of the input DCM file for fat, if any
        },
    },

    // Whether or not to save to file
    "save_dcm": true, // save final recon as .dcm
    "save_dcm_intrabin": false, // save reconstructed bin images as .dcm
    "save_csm": false, // save coil sensitivity maps as .mat
    "save_disp_fields": false, // save displacement_fields as .mat
    "save_images": false, // save denoised images as .mat
    "save_stdout": true, // save console output to stdout.txt (prints, warnings, errors)

    "bins_only": false, // if true will only reconstruct bin images and stop

    // Output DICOM params
    "dicom_params": {
        // clip image values by a percentage before saving to DICOM
        "min_perc": 9,
        "max_perc": 99,
    },
    "coil_params": {
        "use_only": [], // select which coils to use (pass empty list to use all coils)
        "csm_algorithm": "espirit", // one of: espirit, walsh, scanner
        "n_compressed_coils": -1, // Set to -1 to not compress coils
        "csm_params": {
            // walsh only params:
            "smoothing" : 5,
            // espirit only params:
            "bart_params": "-r 20 -k 5 -c 0 -S",
            // scanner only params:
            "filename": "", // filename for .raw file with CSM given by the scanner
                // file should be located in acq_folder/raw/
        },
    },
    "selected_contrasts": {
        // Which contrasts to load (pass empty list to use all)
        "echoes": [],
        "sets": [],
        "repetitions": [],
    },
    "selected_contrasts_for_rating": {
        // which contrast to use for coil sensitivities estimation
        "echo": 1,
        "set": 1,
        "repetition": 1,
    },
    "motion_correction_params": {
        "type": "non_rigid", // none, translational, non_rigid
        // non_rigid only params:
        "n_bins": 4, // number of respiratory bins
        "ref_bin": 4, // 1: inspiration, end: expiration
            // set to 0 to reconstruct to all bins
        "n_interp_bins": 4, // number of bins to interpolate to (does not interpolate if equal to n_bins)
            // If different than n_bins, implies ref_bin=0
        "bin_recon_type": "admm", // one of: it_sense, orcca, admm
        "soft_fn": "bin_range_scaled", // choose exponential decay function, one of bins_avg, bin_range, bin_range_scaled
        "soft_decay": 1, // exponential decay for the soft binning
        "intrabin_TL_corr": true, // whether or not to apply intrabin translational correction
        "bin_resolution_factor": 1, // Set it to less than 1 to reduce bin images resolution (e.g. 0.5)
        "bin_denoise": false, // whether or not to apply HD PROST denoising to bin images
        "load_bin_images" : "", // name of the run from which the bin images are loaded, set as "" to calculate the bin images
            // note: reconstructed bin images are complex, but loaded bin images are real images (this is enough for DF calculation)
        "load_disp_fields" : "", // name of the run from which the displacement fields are loaded, set as "" to calculate the disp fields
        "filter_bin_kspace_gaussian": -1, // if > 0, applies a gaussian filter to bin kspace with specified sigma
        "divide_dfs_by_resolution": false, // Set to true to transform DFs from mm to pixel space
        "bin_prost_params": { // only used if bin_denoise == true, or if bin_recon_type == admm
            // Same parameters as prost_params below
            "sig": 0.055,
            "patch_sz": 5,
            "max_patch": 20,
            "win": 20,
            "offset": 4,
            "debug": 0,
            "recon_mode": 6,
            "sharpness": 0,
            "type": 0,
        },
        "admm_params": { // only used if bin_recon_type == admm
            // same parameters as admm_params below
            "max_iter": 5,
            "cg_max_iter_first": 3,
            "cg_max_iter": 3,
            "cg_residual_tol": 1e-10,
            "cg_lambda": 0.6,
            "verbose": 0,
        },
        "it_sense_params": { // only used if bin_recon_type == it_sense
            // same parameters as it_sense_params below
            "max_iter": 3,
            "residual_tol": 1e-10,
            "verbose": 0,
        },
        "orcca_params": { // only used if bin_recon_type == orcca
            // if weight_scale > 0, other weights are scaled with the data,
            // i.e. weight_X = weight_X * weight_scale * max(data)
            // if weight_scale <= 0, other weights are used as is
            "weight_scale": 0.00001,

            "weight_L1": 0,
            "weight_TV": 1,
            "weight_TV_Temp": 0,
            "weight_MTV": 150,
            "weight_id": 0,

            "max_iter": 5, // outer loop iterations
            "rel_norm_tol": 0.001, // stop if image norm (relative) improves less than this
            "verbose": 1,
            "n_threads": 5, // set to a number or "ncoils"
            "L1_smooth": 1e-15,
            "line_search_params": {
                "max_iter": 20, // inner loop iterations
                "alpha": 0.01,
                "beta": 0.6,
                "step_size": 1,
                "adapt_step": true, // if present, adapts step_size in each iteration
            },
        },
        "registration_params": {
            "clip_df": [-1, -1, -1],
                // if >= 0 will clip DF magnitude in [FH, RL, AP] direction
            "nifty_params": "--nmi -be 0.0005 -sx -14", // params given to nifty's reg_f3d
                // See reg_f3d --help for more parameters
            "n_cores": 8, // Number of threads used by niftyreg
            "method": "pairwise", // one of pairwise, chain
            "orientation": "ascending",
                // one of "ascending", "descending" or "both"
                // only useful for method=chain
        },
        "selected_contrast_for_disp_fields": {
            // Choose a fixed contrast to use for displacement fields
            "echo": -1, // Set to -1 to use each contrast for disp fields
            "set": -1,
            "repetition": -1,
        }
    },
    "reconstruction_type": "admm", // it_SENSE, admm
    "denoising_type": "none", // none, HD_PROST
    "prost_params": {
        "sig": 0.055,
        "patch_sz": 5,
        "max_patch": 20,
        "win": 20,
        "offset": 4,
        "debug": 1,
        "recon_mode": 6,
        "sharpness": 0,
        "type": 0,
    },
    "admm_params": {
        "max_iter": 5, // Max ADMM iterations
        "cg_max_iter_first": 3, // Max CG iterations in the first ADMM iteration
        "cg_max_iter": 3, // Max CG iterations in the other ADMM iterations
        "cg_residual_tol": 1e-10, // Stops if residuals improve less than this
        "cg_lambda": 0.6, // Prior's weight
        "verbose": 0,
    },
    "it_sense_params": {
        "max_iter": 4, // Max iterations
        "residual_tol": 1e-10, // Stops if residuals improve less than this
        "verbose": 0,
    }
}
