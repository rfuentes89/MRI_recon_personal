{
    // Run name will be used to save output files
    "run_name": "NR_itsense",
    "run_name_prepend_datestamp": false, // prepend "yyyy-mm-dd_" to run_name

    "notes": "You can add custom notes to remind yourself what you were trying in this run",

    // If specified and > 0 (e.g. 20), kdata will be reduced to run the code faster,
    // only useful to test the code
    // If present, will add "_DEBUG" to the run_name
    "debug_ksize": 0,

    // Whether or not to override results if using the same run_name
    "override_if_exists": false,

    // Acquisition folder
    // Use $WORKSPACE to replace by your workspace folder
    // Use ~ to replace by your home
    "acq_folder": "$WORKSPACE/acquisitions/ismrm2024/2024-01-01_HV1_BOOST",

    // Raw data from scanner
    // Will be searched in folder: acq_folder/raw/
    "twix_fname": "example_twix.dat",

    // Motion curve options
    "motion_curve": {
        "name": "inav-heart", // custom name to save motion_curves
        "recompute": false, // if present, will compute curve again and save it
    },

    "zero_rl_motion": true, // if true will ignore right-left motion

    // Options for the sequence
    "seq_params": {
        "scanner_dcms": ["HB1", "HB2"], // Names of the input DCM files for each contrast
        "contrast_names": ["HB1", "HB2"], // contrast names, will be used to store output DCMs
        "bb": { // set to null if not needed
		    "scanner_dcm": "BB", // Name of the input DCM file for black blood
		    "contrast_name": "BB", // Name for the BB output DCM
	    },
    },

    // Whether or not to save to file
    "save_dcm": true, // save final recon as .dcm
    "save_dcm_intrabin": false, // save reconstructed bin images as .dcm
    "save_csm": false, // save coil sensitivity maps as .mat
    "save_data": false, // save motion corrected data as .mat
    "save_images": false, // save images before denoising as .mat
    "save_disp_fields": false, // save displacement_fields as .mat
    "save_stdout": true, // save console output to stdout.txt (prints, warnings, errors)

    // Output DICOM params
    "dicom_params": {
        // clamp image values by a percentage before saving to DICOM
        "min_perc": 10,
        "max_perc": 100,
    },
    "coil_params": {
        "use_only": [], // pass empty list to use all coils
        "csm_algorithm": "ESPIRiT", // SOS, ESPIRiT, WASLH
        "n_compressed_coils": -1, // Set to -1 to not compress coils
        "reject_via_ui": false, // display UI to reject coils manually
    },
    "selected_contrasts": {
        // pass empty list to use all
        "echoes": [],
        "sets": [],
        "repetitions": [],
    },
    "selected_contrasts_for_rating": {
        // select contrast to use for coil selection and sensitivities calculation
        "echo": 1,
        "set": 1,
        "repetition": 1,
    },
    "motion_correction_params": {
        "type": "non_rigid", // none, translational, non_rigid
        // non_rigid only params:
        "n_bins": 4, // number of respiratory bins
        "ref_bin": 4, // 1: inspiration, end: expiration
        "bin_recon_type": "it_sense", // it_sense, orcca
        "soft_fn": "bin_range_scaled", // choose exponential decay function, one of bins_avg, bin_range, bin_range_scaled
        "soft_decay": 1, // exponential decay for the soft binning
        "intrabin_TL_corr": true, // whether or not to apply intrabin translational correction
        "orcca_params": { // only used if bin_recon_type == orcca
            // if weight_scale > 0, other weights are scaled with the data,
            // i.e. weight_X = weight_X * weight_scale * max(data)
            // if weight_scale <= 0, other weights are used as is
            "weight_scale": 0.00001,

            "weight_L1": 1,
            "weight_TV": 1,
            "weight_TV_Temp": 1,
            "weight_MTV": 1,
            "weight_id": 1,

            "max_iter": 5, // outer loop iterations
            "rel_norm_tol": 0.001, // stop if image norm (relative) improves less than this
            "verbose": 1,
            "n_threads": 5, // set to a number or "ncoils"
            "L1_smooth": 1e-15,
            "line_search_params": {
                "max_iter": 20, // inner loop iterations
                "alpha": 0.01,
                "beta": 0.6,
                "step_size": 1,
                "adapt_step": true, // if present, adapts step_size in each iteration
            },
        },
        "selected_contrast_for_disp_fields": {
            // Choose a fixed contrast to use for displacement fields
            "echo": -1, // Set to -1 to use each contrast for disp fields
            "set": -1,
            "repetition": -1,
        }
    },
    "reconstruction_type": "it_SENSE", // it_SENSE, admm
    "denoising_type": "HD_PROST", // none, HD_PROST
    "water_fat_algorithm": "none",
    "prost_params": {
        "sig": 0.055,
        "patch_sz": 5,
        "max_patch": 20,
        "win": 20,
        "offset": 4,
        "debug": 1,
        "recon_mode": 6,
        "sharpness": 0,
        "type": 0,
    },
    "cg_params": {
        "ADMM_maxit": 3,
        "CG_minres": 1e-10,
        "CG_maxit_ini": 5,
        "CG_maxit": 5,
        "CG_lambda": 0.01,
    }
}
